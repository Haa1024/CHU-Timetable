<?xml version="1.0" encoding="utf-8"?>
<!--
  桌面小组件专用色值（深色）。与 ui/theme/Theme.kt 的 **DarkChuColors** 一致。

  主色提亮到 #5B7FC7：原值 #133984 本身已经很暗，压在深底上几乎与背景糊成一片，
  按钮与强调色都会看不出边界。这与东大绿在深色下提亮成 #6EA64C 是同一手法。

  为什么必须与**默认配色**对齐，见 values/colors_widget.xml 里的说明。
-->
<resources>
    <color name="widget_surface">#171A21</color>
    <color name="widget_border">#262C3A</color>
    <color name="widget_divider">#262C3A</color>
    <color name="widget_text_primary">#F2F2F7</color>
    <color name="widget_text_secondary">#99A1AD</color>
    <color name="widget_primary">#5B7FC7</color>
    <color name="widget_ongoing_bg">#16203A</color>
</resources>
