<?xml version="1.0" encoding="utf-8"?>
<!--
  网络安全配置。

  【为什么必须放行明文】

  长安大学的课表业务系统本身就是 http —— `http://bkjw.chd.edu.cn/eams/` 全程明文，
  没有 https 版本；只有认证域 `https://ids.chd.edu.cn/authserver` 是 https。

  Android 自 targetSdk 28 起默认禁止明文 HTTP。不放开这条的具体后果是：
  OkHttp 在发请求前就抛
  `CLEARTEXT communication to bkjw.chd.edu.cn not permitted by network security policy`，
  课表接口一个都调不通，登录也会卡在「换票回跳」那一跳。

  【为什么它不只是"业务接口要用"】

  认证服务端回跳时 `service` 参数由服务端配置成 http://，客户端改不了；
  登录成功后要按该 service 明文回跳一次（带 ticket）。
  所以这条例外同时兜住「换票回跳」，少放行它，现象是「登录成功却跳不回来」。

  仍然限定在 chd.edu.cn 之内：默认策略保持禁止明文，其余域名一律不放行。
-->
<network-security-config>

    <!-- 默认禁止明文，不得改为 true。 -->
    <base-config cleartextTrafficPermitted="false" />

    <!-- 长安大学：业务系统本体即 http，且换票回跳也落在这个域上。 -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">chd.edu.cn</domain>
    </domain-config>

</network-security-config>
